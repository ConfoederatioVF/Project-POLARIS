{
  belarus_geocode_rgb: [169, 201, 169],
  geojson_metadata_filename: "config/belarus_ukraine_geojson_metadata.json",
  include_all_periods_geojson: true,
  kriging_metadata_filename: "config/belarus_ukraine_kriging_metadata.json",
  output_geojson_subfolder: "geojson",
  output_kriged_rasters_subfolder: "1.kriged_rasters",
  output_population_rasters_subfolder: "2.population_rasters",
  png_compression_level: 6,
  ukraine_geocode_rgb: [97, 150, 175],

  // Geographic mask, Parameter-Free Non-Stationary Matérn (nu = 3/2) Log-Linear Residual Kriging & Substrata Interpolation configuration
  // Encompasses the land area of modern Belarus (BLR) and mainland Ukraine (UKR, excluding Crimea, which is covered in sites_IA_RAS),
  // spanning c. 1 AD (HYDE benchmark 0) to the Mongol Conquests / post-Mongol transition (1400 AD).
  kriging_config: {
    all_hyde_years: [
      -10000, -9000, -8000, -7000, -6000, -5000, -4000, -3000, -2000, -1000,
      0, 100, 200, 300, 400, 500, 600, 700, 800, 900,
      1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700,
      1710, 1720, 1730, 1740, 1750, 1760, 1770, 1780, 1790,
      1800, 1810, 1820, 1830, 1840, 1850, 1860, 1870, 1880, 1890,
      1900
    ],
    belarus_geocode_rgb: [169, 201, 169],
    coastal_bfs_max_distance_px: 8,
    covariate_paths: {
      forest_asc: "histmap/1.data_raw/metadata_HYDE/general_files/forest_wwf_cr.asc",
      hyde_mcevedy_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_mcevedy",
      hyde_popc_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_scaled_to_global",
      hyde_raw_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters",
      hyde_uopp_raster: "histmap/2.data_cleaning/landuse_HYDE/rasters/uopp_2023AD.png",
      kk10_fallback_folder: "histmap/2.data_cleaning/population_KK10LUH2/rasters_KK10LUH2_2._global_scaling",
      maxln_asc: "histmap/1.data_raw/metadata_HYDE/general_files/maxln_cr.asc",
      outlier_masks: [],
      stadester_urban_folder: "histmap/2.data_cleaning/population_Stadester/stadester_urban_rasters",
      sub_iso_asc: "histmap/1.data_raw/metadata_HYDE/general_files/sub_iso_cr.asc",
      urban_mask_buffer_radius: 1,
      urban_mask_inpaint_radius: 4,
      urban_outlier_spike_ratio: 8.0,
      urban_uopp_threshold: 10.0
    },
    crimea_bbox: {
      max_lat: 46.23,
      max_lon: 36.66,
      min_lat: 44.35,
      min_lon: 32.45,
      peninsula_interior_max_lat: 45.90
    },
    cshapes_crimea_gwcode: 365,
    cshapes_crimea_gweyear: 2019,
    dimensionless_lag_bins: [1.5, 2.5, 4.0, 6.0, 9.0, 13.0, 18.0, 25.0, 35.0, 50.0],
    earth_radius_km: 6371,
    excluded_oblast_ids: [],
    frontier_blend_blur_factor: 3,
    frontier_blend_macro_factor: 6,
    frontier_conditioning_max_dist_km: 250,
    grid_height: 2160,
    grid_width: 4320,
    russian_ia_ras_folder: "histmap/1.data_raw/population_regional/russia/1.entire_country/sites_IA_RAS",
    steppe_settled_period_keys: [
      "iron_age",
      "migration_period",
      "middle_ages",
      "early_modern_17_18c",
      "modern"
    ],
    ukraine_geocode_rgb: [97, 150, 175],

    // Chronological horizons defined by documented East Slavic / Kievan Rus and prehistoric period boundaries (-10000 to 1400 AD).
    // Active periods at each horizon are summed directly in their empirical site-count units.
    chronological_horizons: [
      {
        active_periods: ["stone_age"],
        key: "stone_age_mesolithic_neolithic_horizon",
        year: -10000
      },
      {
        active_periods: ["stone_age", "eneolithic"],
        key: "early_eneolithic_horizon",
        year: -5000
      },
      {
        active_periods: ["stone_age", "eneolithic", "palaeometal", "early_metal_age"],
        key: "trypillia_mega_site_eneolithic_horizon",
        year: -3500
      },
      {
        active_periods: ["palaeometal", "early_metal_age", "bronze_age"],
        key: "bronze_age_horizon",
        year: -2000
      },
      {
        active_periods: ["iron_age", "classical_antiquity"],
        key: "scythian_classical_horizon",
        year: -500
      },
      {
        active_periods: ["iron_age", "classical_antiquity"],
        key: "late_iron_classical_horizon",
        year: 0
      },
      {
        active_periods: ["iron_age", "classical_antiquity", "migration_period", "middle_ages"],
        key: "chernyakhov_migration_onset_horizon",
        year: 400
      },
      {
        active_periods: ["migration_period", "middle_ages"],
        key: "early_slavic_rus_transition_horizon",
        year: 750
      },
      {
        active_periods: ["middle_ages"],
        key: "kievan_rus_high_middle_ages_horizon",
        year: 1000
      },
      {
        active_periods: ["middle_ages"],
        key: "mongol_conquest_1400_horizon",
        year: 1400
      }
    ],

    // 25 HYDE benchmark years spanning 10000 BC (-10000) to the Mongol Conquests / 1400 AD cutoff
    hyde_years: [
      -10000, -9000, -8000, -7000, -6000, -5000, -4000, -3000, -2000, -1000,
      0, 100, 200, 300, 400, 500, 600, 700, 800, 900,
      1000, 1100, 1200, 1300, 1400
    ]
  },

